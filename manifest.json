{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "version": "0.0.2",
  "description": "__MSG_extensionPresentation__",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-cookie-exporter@electroniqueexpertise.fr",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "cookies",
    "downloads",
    "storage",
    "alarms",
    "https://youtube.com/*",
    "https://*.youtube.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "__MSG_browserActionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  }
}
