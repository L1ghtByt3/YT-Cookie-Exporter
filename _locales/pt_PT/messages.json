    "message": "Erro: $error$",
    "placeholders": {
      "error": {
        "content": "$1"
      }
    }
  },
  "invalidInterval": {
    "message": "Introduza um intervalo válido."
  },
  "intervalSaved": {
    "message": "Intervalo de exportação guardado."
